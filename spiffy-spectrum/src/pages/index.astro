    <!-- ============ 結語:手寫「11/22 台東見」 ============ -->
    <section class="closing fade-up">
      <!-- TODO: 換成你手寫「11/22 台東見」的去背金色圖片,做法跟「靖」「瑜」一樣 -->
      <span class="closing-hand">11/22 台東見 ₍•͈ᴗ•͈₎</span>
      <span class="names-sm">Jian Chung &amp; Tzu Yu</span>
    </section>

  </div> <!-- page-wrapper 結束 -->

  <script>
    // 禁用右鍵選單
    document.addEventListener('contextmenu', e => e.preventDefault());

    // ---------- 地圖嵌入 ----------
    document.getElementById('map').src =
      'https://www.google.com/maps?q=' +
      encodeURIComponent('The GAYA Hotel 潮渡假酒店 台東縣台東市新生路169號') +
      '&output=embed';

    // ---------- 捲動浮現動畫 ----------
    document.addEventListener("DOMContentLoaded", function() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

      // 街景照片依序浮現(不是同時出現,製造節奏感)
      const streetPhotos = document.querySelectorAll('.street-photo');
      const photoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if(entry.isIntersecting){
            const order = Array.from(streetPhotos).indexOf(entry.target);
            setTimeout(() => entry.target.classList.add('in-view'), order * 220);
            photoObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });
      streetPhotos.forEach(el => photoObserver.observe(el));
    });

    // ---------- 第一章背景照片輪播 ----------
    let currentHero = 0;
    const heroSlides = document.querySelectorAll('.hero-bg-slide');
    function changeHero() {
      if(heroSlides.length === 0) return;
      heroSlides[currentHero].classList.remove('active');
      currentHero = (currentHero + 1) % heroSlides.length;
      heroSlides[currentHero].classList.add('active');
    }
    setInterval(changeHero, 5000);

    // ---------- 飯店介紹背景照片輪播 ----------
    let currentVenue = 0;
    const venueSlides = document.querySelectorAll('.venue-bg');
    function changeVenue() {
      if(venueSlides.length === 0) return;
      venueSlides[currentVenue].classList.remove('active');
      currentVenue = (currentVenue + 1) % venueSlides.length;
      venueSlides[currentVenue].classList.add('active');
    }
    setInterval(changeVenue, 6000);

    // ---------- 音樂播放與章節切換(淡入淡出,只觸發一次) ----------
    const bgMusic = document.getElementById('bgMusic');
    const musicToggle = document.getElementById('musicToggle');
    const musicIcon = musicToggle.querySelector('.music-icon');
    let isPlaying = false;
    let currentTrack = null;

    function fadeToTrack(src){
      if(!isPlaying || currentTrack === src) return;
      currentTrack = src;
      const fadeOutStep = () => {
        if(bgMusic.volume > 0.05){
          bgMusic.volume -= 0.05;
          setTimeout(fadeOutStep, 40);
        }else{
          bgMusic.src = src;
          bgMusic.volume = 0;
          bgMusic.play().catch(()=>{});
          fadeInStep();
        }
      };
      const fadeInStep = () => {
        if(bgMusic.volume < 0.95){
          bgMusic.volume += 0.05;
          setTimeout(fadeInStep, 40);
        }else{
          bgMusic.volume = 1;
        }
      };
      fadeOutStep();
    }

    musicToggle.addEventListener('click', () => {
      if(isPlaying){
        bgMusic.pause();
        musicIcon.classList.remove('playing');
        isPlaying = false;
      }else{
        if(!currentTrack){
          currentTrack = document.getElementById('chapter1').dataset.track;
          bgMusic.src = currentTrack;
          bgMusic.volume = 1;
        }
        bgMusic.play().catch(()=>{});
        musicIcon.classList.add('playing');
        isPlaying = true;
      }
    });

    function setupChapterTransition(chapterId, pageTurnId){
      const chapterEl = document.getElementById(chapterId);
      const pageTurnEl = document.getElementById(pageTurnId);
      let triggered = false;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if(entry.isIntersecting && !triggered){
            triggered = true;
            pageTurnEl.classList.add('active');
            fadeToTrack(chapterEl.dataset.track);
          }
        });
      }, { threshold: 0.3 });
      observer.observe(chapterEl);
    }
    setupChapterTransition('chapter2', 'pageTurn1');
    setupChapterTransition('chapter3', 'pageTurn2');

    // ---------- RSVP 表單計數邏輯 ----------
    const counts = { rsvpAdults: 1, rsvpKids: 0, rsvpVeg: 1 };
    function stepCount(id, delta){
      const min = id === 'rsvpAdults' ? 1 : 0;
      counts[id] = Math.max(min, counts[id] + delta);
      document.getElementById(id).textContent = counts[id];
    }
    window.stepCount = stepCount;

    function toggleVeg(){
      const on = document.getElementById('rsvpVegCheck').checked;
      document.getElementById('vegCountRow').style.display = on ? 'flex' : 'none';
    }
    window.toggleVeg = toggleVeg;

    // ---------- RSVP 送出(串接 Google Apps Script) ----------
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxNkz5i5FCrU7cea06DDt7Nw3_LcHCWLeKNrABCd-8LpSt8lE3xmeDkRK1k3AtgMdPL8g/exec';

    async function submitRSVP(){
      const name = document.getElementById('rsvpName').value.trim();
      if(!name){ alert('請填寫姓名'); return; }

      const adults = counts.rsvpAdults;
      const kids = counts.rsvpKids;
      const vegOn = document.getElementById('rsvpVegCheck').checked;
      const veg = vegOn ? counts.rsvpVeg : 0;
      const entry = { name, adults, kids, veg, note: '' };

      const btn = document.getElementById('rsvpSubmitBtn');
      btn.disabled = true;
      btn.textContent = '送出中...';

      try{
        if(SCRIPT_URL){
          await fetch(SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(entry)
          });
        }
        document.getElementById('rsvpForm').style.display = 'none';
        document.getElementById('thankYou').style.display = 'block';
      }catch(err){
        console.error(err);
        alert('送出時發生問題，請稍後再試一次。');
        btn.disabled = false;
        btn.textContent = '確認送出';
      }
    }
    window.submitRSVP = submitRSVP;
  </script>

</body>
