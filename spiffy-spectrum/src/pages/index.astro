    .closing .names-sm{ font-family:'Cormorant Garamond', serif; font-style:italic; font-size:1.2rem; color: var(--ink-soft); letter-spacing: 0.1em; display: block; margin-top: 0.8rem; }

    /* ============ 滑動浮現特效 ============ */
    .fade-up { opacity: 0; transform: translateY(30px); transition: opacity 1s ease-out, transform 1s ease-out; }
    .fade-up.visible { opacity: 1; transform: translateY(0); }

    /* ============ 手機版字級調整 ============ */
    @media (max-width: 480px) {
      .hero-topbar { font-size: 0.85rem; letter-spacing: 0.08em; }
