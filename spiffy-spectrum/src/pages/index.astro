  <script is:inline type="application/json" id="seatData">{"layout":{"view":[480,150,480,710],"stage":{"x":605,"y":770,"w":190,"h":68,"label":"舞台"},"carpet":[[633,190,54,575],[460,190,200,32]],"entrance":{"x":445,"y":206},"tables":[{"id":"10","x":565,"y":292},{"id":"7","x":565,"y":420},{"id":"5","x":565,"y":550},{"id":"2","x":565,"y":685},{"id":"9","x":750,"y":240},{"id":"6","x":750,"y":398},{"id":"4","x":750,"y":535},{"id":"主桌","x":750,"y":690},{"id":"8","x":868,"y":322},{"id":"3","x":868,"y":610}]},"guests":[{"name":"唐靖軒","table":"主桌"},{"name":"林子瑜","table":"主桌"},{"name":"子瑜爸媽","table":"主桌"},{"name":"唐翊","table":"主桌"},{"name":"張月庒","table":"主桌"},{"name":"阿嬤 舅公","table":"主桌","alias":["阿嬤","舅公"]},{"name":"你大姐","table":"主桌"},{"name":"何智蓮","table":"主桌"},{"name":"杜文喜 家人","table":"2","alias":["杜文喜","家人"]},{"name":"二姨 二姨丈","table":"2","alias":["二姨","二姨丈"]},{"name":"林峰","table":"2"},{"name":"盧庭宇","table":"2"},{"name":"林士雅","table":"2"},{"name":"馬品薫","table":"5"},{"name":"李洳君","table":"5"},{"name":"凌牧珍","table":"5"},{"name":"陳怡婷","table":"5"},{"name":"陳依筠","table":"5"},{"name":"蔡云槿","table":"7"},{"name":"郭孟婷","table":"7"},{"name":"鄭朋朋","table":"7"},{"name":"李嘉慧","table":"7"},{"name":"黃柏堯","table":"7"},{"name":"胡世璋","table":"7"},{"name":"沈家菘","table":"7"},{"name":"詹仕維","table":"7"},{"name":"二阿姨","table":"3"},{"name":"大阿姨","table":"3"},{"name":"唐建清","table":"3"},{"name":"唐誼敏","table":"3"},{"name":"唐翊秀","table":"3"},{"name":"唐玗蓁","table":"3"},{"name":"高千惠","table":"4"},{"name":"陽永慶","table":"4"},{"name":"林衍光","table":"4"},{"name":"侯智升","table":"4"},{"name":"蔡昆益","table":"4"},{"name":"陳郁名","table":"4"},{"name":"胡恩誌","table":"4"},{"name":"鄭子賢","table":"4"},{"name":"邱旻杰","table":"4"},{"name":"陳世昌","table":"6"},{"name":"江俊賢","table":"6"},{"name":"陳耀宗","table":"6"},{"name":"高石濬","table":"6"},{"name":"邱智鴻","table":"6"},{"name":"張智華","table":"6"},{"name":"胡維勳","table":"6"},{"name":"徐思偉","table":"6"},{"name":"郭佳霖","table":"6"},{"name":"余俊陞","table":"9"},{"name":"陳政憲","table":"9"},{"name":"巴耀祖","table":"9"},{"name":"吳政輝","table":"9"},{"name":"方勇博","table":"9"},{"name":"田杜柏軒","table":"9"},{"name":"林震","table":"8"},{"name":"郝律緯","table":"8"},{"name":"廖沛翔","table":"8"},{"name":"林宗翰","table":"8"},{"name":"曾志齊","table":"8"},{"name":"邱中皓","table":"8"},{"name":"楊雲中","table":"8"},{"name":"陳逸然","table":"8"},{"name":"曾建智","table":"10"},{"name":"李政傑","table":"10"},{"name":"吳承皓","table":"10"},{"name":"陳志文","table":"10"},{"name":"洪雄偉","table":"10"}]}</script>

  <script>
    // ===== 座位查詢 =====
    (function(){
      const gate = document.getElementById('seatGate');
      const input = document.getElementById('sgInput');
      const listEl = document.getElementById('sgResults');
      const mapEl = document.getElementById('sgMap');
      const root = document.documentElement;
      let guests = [], layout = null;
      let hits = [], sel = 0, composing = false;

      const fab = document.getElementById('seatFab');
      let hideTimer = null;

      // 連結帶 hash（例如 #venue）時，直接略過座位頁
      if (location.hash && location.hash.length > 1) {
        gate.style.display = 'none';
        fab.classList.add('show');
      } else {
        root.classList.add('gate-open');
      }

      function closeGate(){
        gate.classList.add('leaving');
        root.classList.remove('gate-open');
        fab.classList.add('show');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => { gate.style.display = 'none'; window.scrollTo(0, 0); }, 600);
      }
      function openGate(){
        clearTimeout(hideTimer);
        fab.classList.remove('show');
        gate.style.display = 'flex';
        gate.scrollTop = 0;
        void gate.offsetWidth;
        gate.classList.remove('leaving');
        root.classList.add('gate-open');
      }
      document.getElementById('sgEnter').addEventListener('click', closeGate);
      fab.addEventListener('click', openGate);

      const norm = (t) => (t || '').toString().replace(/\s+/g, '').toLowerCase();
      const isNum = (t) => /^\d+$/.test(String(t));
      const tableLabel = (t) => isNum(t) ? '第 ' + t + ' 桌' : t;
      const esc = (t) => String(t).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

      function buildMap(){
        const L = layout;
        if (!L || !L.tables) { mapEl.innerHTML = ''; return; }
        const v = L.view;
        let svg = '<svg viewBox="' + v.join(' ') + '" xmlns="http://www.w3.org/2000/svg">';
        // 進場路線：畫成一個 L 形整體，不會有重疊
        svg += '<path class="carpet" d="M460 190 H687 V765 H633 V222 H460 Z" stroke-linejoin="round"/>';
        svg += '<text class="vlabel" x="660" y="0">' + ['進','場','路','線'].map((c,i)=>'<tspan x="660" y="'+(427+i*34)+'">'+c+'</tspan>').join('') + '</text>';
        const st = L.stage;
        svg += '<g class="stage"><rect x="'+st.x+'" y="'+st.y+'" width="'+st.w+'" height="'+st.h+'" rx="8"/>' +
               '<text x="'+(st.x+st.w/2)+'" y="'+(st.y+st.h/2)+'">'+esc(st.label)+'</text></g>';
        if (L.entrance) svg += '<text class="entry" x="486" y="172" style="text-anchor:start">ENTRANCE ›</text>';
        L.tables.forEach(t => {
          let chairs = '';
          for (let i = 0; i < 10; i++) {
            const ang = i / 10 * Math.PI * 2 - Math.PI / 2;
            chairs += '<circle class="chair" cx="'+(t.x + 54*Math.cos(ang)).toFixed(1)+'" cy="'+(t.y + 54*Math.sin(ang)).toFixed(1)+'" r="7"/>';
          }
          const fs = isNum(t.id) ? 30 : 22;
          svg += '<g class="tbl" data-t="'+esc(t.id)+'">' +
            '<circle class="pulse" cx="'+t.x+'" cy="'+t.y+'" r="41"/>' + chairs +
            '<circle class="body" cx="'+t.x+'" cy="'+t.y+'" r="41"/>' +
            '<text x="'+t.x+'" y="'+t.y+'" font-size="'+fs+'">'+esc(t.id)+'</text></g>';
        });
        svg += '</svg>';
        mapEl.innerHTML = svg;
        paint();
      }

      function paint(){
        const cur = hits[sel] ? String(hits[sel].table) : null;
        const others = new Set(hits.map(g => String(g.table)));
        mapEl.querySelectorAll('.tbl').forEach(el => {
          const t = el.getAttribute('data-t');
          el.classList.toggle('on', t === cur);
          el.classList.toggle('alt', t !== cur && others.has(t));
        });
      }

      function renderList(){
        const q = norm(input.value);
        if (!q) { listEl.innerHTML = ''; return; }
        if (!hits.length) {
          listEl.innerHTML = '<p class="sg-msg">找不到這個名字<br>請試試只輸入姓氏，或洽現場接待人員</p>';
          return;
        }
        listEl.innerHTML = hits.map((g, i) =>
          '<button type="button" class="sg-card' + (i === sel ? ' sel' : '') + '" data-i="' + i + '">' +
          '<span class="sg-name">' + esc(g.name) + '</span>' +
          '<span class="sg-table">' + esc(tableLabel(g.table)) + '</span></button>'
        ).join('') + (hits.length > 1 ? '<p class="sg-hint">點選姓名，座位圖會跟著切換</p>' : '');
      }

      function search(){
        const q = norm(input.value);
        hits = q ? guests.filter(g =>
          norm(g.name).includes(q) || (g.alias || []).some(a => norm(a).includes(q))
        ).slice(0, 30) : [];
        sel = 0;
        renderList();
        paint();
      }

      listEl.addEventListener('click', (e) => {
        const btn = e.target.closest('.sg-card');
        if (!btn) return;
        sel = +btn.getAttribute('data-i');
        renderList();
        paint();
      });

      input.addEventListener('compositionstart', () => { composing = true; });
      input.addEventListener('compositionend', () => { composing = false; search(); });
      input.addEventListener('input', () => { if (!composing) search(); });

      const debug = /[?&]debug\b/.test(location.search);
      function note(msg){
        if (!debug) return;
        let el = document.getElementById('sgDebug');
        if (!el) { el = document.createElement('p'); el.id = 'sgDebug'; el.className = 'sg-hint'; input.parentNode.appendChild(el); }
        el.textContent = '[debug] ' + msg;
      }
      function apply(d, source){
        guests = Array.isArray(d) ? d : (d.guests || []);
        layout = Array.isArray(d) ? null : (d.layout || null);
        note('資料來源：' + source + '，賓客 ' + guests.length + ' 筆，桌子 ' + (layout && layout.tables ? layout.tables.length : 0) + ' 張');
        buildMap();
        search();
      }

      // ===== 用手機更新座位：Google 試算表 =====
      // 把「發佈到網路」的 CSV 連結貼在下面的引號中間，賓客名單就會改讀試算表（改完約幾分鐘內生效）。
      // 留空、或試算表讀不到時，會自動使用下面網頁內嵌的名單，所以不會壞掉。
      const SHEET_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSUc2Av7DJUcK0mTRrwwhZs-klzz_fOJEoRaP7c143h510nBBJ_n83cKApSnSXOZ-LcJxjaQb0e7HIr/pub?gid=2014131562&single=true&output=csv';

      function parseCSV(text){
        const rows = []; let row = [], cur = '', q = false;
        text = text.replace(/^\uFEFF/, '');
        for (let i = 0; i < text.length; i++) {
          const c = text[i];
          if (q) {
            if (c === '"') { if (text[i+1] === '"') { cur += '"'; i++; } else q = false; }
            else cur += c;
          } else if (c === '"') q = true;
          else if (c === ',') { row.push(cur); cur = ''; }
          else if (c === '\n' || c === '\r') {
            if (c === '\r' && text[i+1] === '\n') i++;
            row.push(cur); cur = ''; rows.push(row); row = [];
          } else cur += c;
        }
        if (cur !== '' || row.length) { row.push(cur); rows.push(row); }
        return rows;
      }
      function guestsFromCSV(text){
        const out = [];
        parseCSV(text).forEach((r, i) => {
          const name = (r[0] || '').trim();
          let table = (r[1] || '').trim().replace(/^第\s*/, '').replace(/\s*桌$/, '');
          if (!name || !table) return;
          if (i === 0 && /姓名|name/i.test(name)) return;   // 跳過標題列
          if (table === '主') table = '主桌';
          const g = { name: name, table: table };
          const alias = (r[2] || '').split(/[、,，\s]+/).map(a => a.trim()).filter(Boolean);
          if (alias.length) g.alias = alias;
          out.push(g);
        });
        return out;
      }

      // 先用網頁內嵌的資料立刻顯示，再嘗試用試算表更新
      let embedded = null;
      try { embedded = JSON.parse(document.getElementById('seatData').textContent); } catch (e) { console.warn('[座位查詢] 內嵌資料讀取失敗', e); }
      if (embedded) {
        apply(embedded, '內嵌');
      } else if (!SHEET_CSV_URL) {
        fetch('/seats.json', { cache: 'no-store' }).then(r => {
          if (!r.ok) throw new Error('seats.json HTTP ' + r.status);
          return r.json();
        }).then(d => apply(d, 'fetch')).catch((err) => {
          console.error('[座位查詢] 載入 seats.json 失敗：', err);
          note('載入失敗：' + err.message);
          listEl.innerHTML = '<p class="sg-msg">座位資料載入失敗，請稍後再試或洽現場接待人員</p>';
        });
      }
      if (SHEET_CSV_URL) {
        const sep = SHEET_CSV_URL.indexOf('?') > -1 ? '&' : '?';
        fetch(SHEET_CSV_URL + sep + 't=' + Date.now(), { cache: 'no-store' }).then(r => {
          if (!r.ok) throw new Error('試算表 HTTP ' + r.status);
          return r.text();
        }).then(text => {
          const list = guestsFromCSV(text);
          if (!list.length) throw new Error('試算表沒有讀到任何賓客');
          guests = list;
          note('資料來源：Google 試算表，賓客 ' + guests.length + ' 筆');
          search();
        }).catch(err => {
          console.warn('[座位查詢] 試算表讀取失敗，改用內嵌名單：', err);
          note('試算表讀取失敗，使用內嵌名單：' + err.message);
        });
      }
    })();

    document.addEventListener('contextmenu', e => e.preventDefault());
    let wasPlayingBeforeHidden = false;

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        wasPlayingBeforeHidden = isPlaying;
        if (isPlaying) {
          bgMusic.pause();
          musicIcon.classList.remove('playing');
        }
      } else {
        if (wasPlayingBeforeHidden) {
          bgMusic.play().then(() => {
            musicIcon.classList.add('playing');
          }).catch(() => {});
        }
      }
    });
    document.getElementById('map').src =
      'https://www.google.com/maps?q=' +
      encodeURIComponent('The GAYA Hotel 潮渡假酒店 台東縣台東市新生路169號') +
      '&output=embed';

    document.addEventListener("DOMContentLoaded", function() {
      const vcPhotos = document.querySelectorAll('.vc-photo');
      const vcObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if(entry.isIntersecting){
            const order = Array.from(vcPhotos).indexOf(entry.target);
            setTimeout(() => entry.target.classList.add('settled'), order * 400);
            vcObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });
      vcPhotos.forEach(el => vcObserver.observe(el));
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

      const streetPhotos = document.querySelectorAll('.street-photo');
      const photoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if(entry.isIntersecting){
            const order = Array.from(streetPhotos).indexOf(entry.target);
            setTimeout(() => entry.target.classList.add('in-view'), order * 220);
            photoObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });
      streetPhotos.forEach(el => photoObserver.observe(el));

      const ttPhotos = document.querySelectorAll('.tt-photo');
      const ttObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if(entry.isIntersecting){
            entry.target.classList.add('in-view');
            ttObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      ttPhotos.forEach(el => ttObserver.observe(el));
    });

    const scrollHintBtn = document.getElementById('scrollHint');
    if (scrollHintBtn) {
      scrollHintBtn.addEventListener('click', () => {
        const heroSection = document.getElementById('hero-open');
        const next = heroSection && heroSection.nextElementSibling;
        if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    let currentHero = 0;
    const heroSlides = document.querySelectorAll('.hero-bg-slide');
    function changeHero() {
      if(heroSlides.length === 0) return;
      heroSlides[currentHero].classList.remove('active');
      currentHero = (currentHero + 1) % heroSlides.length;
      heroSlides[currentHero].classList.add('active');
    }
    setInterval(changeHero, 3000);

    let currentVenue = 0;
    const venueSlides = document.querySelectorAll('.venue-bg');
    function changeVenue() {
      if(venueSlides.length === 0) return;
      venueSlides[currentVenue].classList.remove('active');
      currentVenue = (currentVenue + 1) % venueSlides.length;
      venueSlides[currentVenue].classList.add('active');
    }
    setInterval(changeVenue, 3500);

    document.querySelectorAll('[data-carousel]').forEach(container => {
      const slides = container.querySelectorAll('.duo-slide');
      if (slides.length < 2) return;
      let idx = 0;
      setInterval(() => {
        slides[idx].classList.remove('active');
        idx = (idx + 1) % slides.length;
        slides[idx].classList.add('active');
      }, 2200);
    });

    const bgMusic = document.getElementById('bgMusic');
    const musicToggle = document.getElementById('musicToggle');
    const musicIcon = musicToggle.querySelector('.music-icon');
    const MUSIC_SRC = '/cc.mp3';
    let isPlaying = false;

    bgMusic.src = MUSIC_SRC;
    bgMusic.volume = 1;

    function startMusic(){
      if(isPlaying) return;
      bgMusic.play().then(() => {
        isPlaying = true;
        musicIcon.classList.add('playing');
      }).catch(() => {});
    }

    function stopMusic(){
      bgMusic.pause();
      isPlaying = false;
      musicIcon.classList.remove('playing');
    }

    startMusic();

    ['scroll', 'touchstart', 'click'].forEach(evt => {
      document.addEventListener(evt, function firstInteraction(){
        startMusic();
      }, { once: true, passive: true });
    });

    musicToggle.addEventListener('click', () => {
      if(isPlaying){
        stopMusic();
      }else{
        startMusic();
      }
    });

  </script>
</body>
</html>